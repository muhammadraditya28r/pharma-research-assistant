OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-6.2-astra

# OpenAlex now requires an API key for normal-scale usage.
OPENALEX_API_KEY=replace_me

# Gmail sender account and Google App Password (not the normal password)
SMTP_USER=sender@gmail.com
SMTP_APP_PASSWORD=replace_with_google_app_password
RECIPIENT_EMAIL=destination@gmail.com

LOOKBACK_DAYS=45
MAX_RESULTS_PER_QUERY=50
MAX_TOTAL_CANDIDATES=250
