GEMINI_API_KEY=replace_me

# Primary model: latest frontier model (paid API tier only).
GEMINI_MODEL=gemini-4-carbon

# Ordered fallbacks. These models have free-tier API access, subject to quotas.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite

# OpenAlex API key
OPENALEX_API_KEY=replace_me

# Gmail sender account and Google App Password (not the normal password)
SMTP_USER=sender@gmail.com
SMTP_APP_PASSWORD=replace_with_google_app_password
RECIPIENT_EMAIL=destination@gmail.com

LOOKBACK_DAYS=45
MAX_RESULTS_PER_QUERY=50
MAX_TOTAL_CANDIDATES=250
